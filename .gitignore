# ============================================================
# J-Agency — Root .gitignore (Frontend & Backend)
# ============================================================

# ── Environment & Secrets ────────────────────────────────────
.env
*.env
**/.env
.env.*
!.env.example
!**/.env.example
local_settings.py

# ── Python bytecode & Cache ──────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual Environments ─────────────────────────────────────
venv/
env/
ENV/
.venv/
*/venv/
*/.venv/

# ── Node & Frontend Build ────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Django Database, Static & Media ──────────────────────────
*.log
db.sqlite3
*.sqlite3
media/
backend/media/
staticfiles/
backend/staticfiles/
static_collected/

# ── OS & IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ── Testing & Coverage ───────────────────────────────────────
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
