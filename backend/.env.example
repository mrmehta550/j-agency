# ============================================================
# J-Agency Backend — Environment Configuration Template
# For Render Deployment & PostgreSQL Database
# Copy this file to .env for local testing (NEVER commit .env)
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# In Render, add SECRET_KEY (or DJANGO_SECRET_KEY) generated via:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-provided-by-render
DJANGO_DEBUG=False

# Comma-separated allowed hostnames (Render provides RENDER_EXTERNAL_HOSTNAME automatically)
# Example: your-backend-domain.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=your-backend-domain.onrender.com,localhost,127.0.0.1

# ── Production PostgreSQL Database (Render) ──────────────────
# Render PostgreSQL Internal Connection String (from Render Postgres Dashboard)
DATABASE_URL=postgres://username:password@dpg-xxxxxx-a.oregon-postgres.render.com/dbname

# ── CORS & CSRF Origins (Allow your Vercel frontend) ─────────
# Put your exact Vercel frontend domain here (e.g. https://j-agency-wlpt.vercel.app)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.onrender.com,https://your-frontend-domain.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ── Admin URL (Security: obscure the admin path in production)
DJANGO_ADMIN_URL=admin/

# ── Email (Gmail SMTP for Contact / Booking notifications) ──
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
