# ============================================================
# J-Agency Backend — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-50-character-random-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated allowed hostnames (Render sets this or use wildcard)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# ── Production Database (PostgreSQL via Render / Railway) ────
# Provide DATABASE_URL for PostgreSQL (dj-database-url will parse automatically)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# Fallback MySQL Database (optional, only if using MySQL)
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ── CORS & CSRF Origins (Allow your Vercel frontend) ─────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ── Admin URL (security: obscure the admin path) ─────────────
DJANGO_ADMIN_URL=admin/

# ── Email (Gmail SMTP) ───────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
